	"version": "0.2.0",
	"configurations": [
		{
			"type": "editor-browser",
			"request": "launch",
			"name": "Debug",
			"url": "http://localhost:10001/",
			"preLaunchTask": "Debug: Start",
			"postDebugTask": "Debug: Stop",
			"webRoot": "${workspaceFolder}/dist",
			"sourceMapPathOverrides": {
				"../app/*": "${workspaceFolder}/app/*",
				"./*": "${workspaceFolder}/*"
			}
		}
	]
}
